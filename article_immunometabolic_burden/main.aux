\@writefile{lof}{\contentsline {figure}{\numberline {E1}{\ignorespaces \textbf  {Cohort assembly and follow-up attrition.} Flow from the three FACE cohorts to the $N=9{,}013$ modelled patients and the $n=2{,}958$ retained at 24 months (of whom $n=2{,}420$ have a complete two-year functional-remission outcome, the sample used in Figure~\ref {fig:money}), with reasons for exclusion at each stage. Retention is associated with baseline map position and is addressed by inverse-probability weighting.}}{17}{figure.1}\protected@file@percent }
\newlabel{edfig:consort}{{E1}{17}{\textbf {Cohort assembly and follow-up attrition.} Flow from the three FACE cohorts to the $N=9{,}013$ modelled patients and the $n=2{,}958$ retained at 24 months (of whom $n=2{,}420$ have a complete two-year functional-remission outcome, the sample used in Figure~\ref {fig:money}), with reasons for exclusion at each stage. Retention is associated with baseline map position and is addressed by inverse-probability weighting}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {E2}{\ignorespaces \textbf  {The full eight-axis loading atlas.} Complete posterior indicator$\times $factor loading matrix for all 143 modelled indicators, extending the summary of Figure~\ref {fig:atlas} to every variable and both the bifactor and correlated-\textit  {G}{} parameterizations.}}{18}{figure.2}\protected@file@percent }
\newlabel{edfig:fullatlas}{{E2}{18}{\textbf {The full eight-axis loading atlas.} Complete posterior indicator$\times $factor loading matrix for all 143 modelled indicators, extending the summary of Figure~\ref {fig:atlas} to every variable and both the bifactor and correlated-\Gfac {} parameterizations}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {E3}{\ignorespaces \textbf  {Measurement invariance across cohorts.} Configural, metric and scalar invariance checks for the eight-axis map across the three cohorts; loadings and thresholds are stable enough that factor scores are comparable across sites.}}{19}{figure.3}\protected@file@percent }
\newlabel{edfig:invariance}{{E3}{19}{\textbf {Measurement invariance across cohorts.} Configural, metric and scalar invariance checks for the eight-axis map across the three cohorts; loadings and thresholds are stable enough that factor scores are comparable across sites}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {E4}{\ignorespaces \textbf  {Leave-one-cohort-out stability.} The map re-estimated with each cohort held out in turn; axis definitions, the immunometabolic separation and the archetype geometry are reproduced, showing no single cohort drives the structure.}}{19}{figure.4}\protected@file@percent }
\newlabel{edfig:loso}{{E4}{19}{\textbf {Leave-one-cohort-out stability.} The map re-estimated with each cohort held out in turn; axis definitions, the immunometabolic separation and the archetype geometry are reproduced, showing no single cohort drives the structure}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {E5}{\ignorespaces \textbf  {Reproducibility benchmarking.} Split-half and re-fit reproducibility of the loading atlas and the general--specific correlation vector $\phi _{Gd}$, with the immunometabolic axis among the most reproducible.}}{20}{figure.5}\protected@file@percent }
\newlabel{edfig:repbench}{{E5}{20}{\textbf {Reproducibility benchmarking.} Split-half and re-fit reproducibility of the loading atlas and the general--specific correlation vector $\phi _{Gd}$, with the immunometabolic axis among the most reproducible}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {E6}{\ignorespaces \textbf  {Confound robustness of the biology axis.} The immunometabolic--\textit  {G}{} correlation $\phi _{Gd}$ under progressive adjustment (age, sex, education, site, then antipsychotic exposure): it does not rise with adjustment, falling from $\approx 0.10$ to $\approx 0.07$, and remains the least burden-entangled axis at every step.}}{20}{figure.6}\protected@file@percent }
\newlabel{edfig:robustness}{{E6}{20}{\textbf {Confound robustness of the biology axis.} The immunometabolic--\Gfac {} correlation $\phi _{Gd}$ under progressive adjustment (age, sex, education, site, then antipsychotic exposure): it does not rise with adjustment, falling from $\approx 0.10$ to $\approx 0.07$, and remains the least burden-entangled axis at every step}{figure.6}{}}
