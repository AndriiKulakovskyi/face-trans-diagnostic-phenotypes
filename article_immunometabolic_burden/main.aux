\citation{penninx2024imd,milaneschi2020,lamers2013,lamers2020}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.2}The patient space is a continuum, summarized by five archetypes}{3}{subsection.2.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.3}Immunometabolic load separates from general severity (the hinge)}{3}{subsection.2.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {A diagnosis-blind, biology-inclusive map of severe mental illness.} Posterior indicator$\times $factor loadings for the eight-axis model fit to $N=9{,}013$ patients' observed cells (no imputation), with the map \emph  {frozen before any validation stage}---a pre-specification that guards the downstream claims against overfitting. Routinely-collected biology (immunometabolic panel) enters as a co-equal latent axis alongside cognition, sleep and the symptom dimensions rather than as a downstream correlate. Marker size is $|$loading$|$; the general factor \textit  {G}{} is orthogonal to the specifics by construction (the primary-map coordinate choice). This map is the coordinate system; the degree to which each axis is entangled with general burden is not read from it (that is set to zero here by construction) but estimated from a free-correlation re-fit, where the immunometabolic axis proves the least entangled of all (Fig.~\ref {fig:hinge}). Unlike prior single-diagnosis immunometabolic-depression subtyping, biology here is a co-equal axis (not a correlate), measured without imputation, across bipolar disorder, schizophrenia and major depression.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:atlas}{{1}{4}{\textbf {A diagnosis-blind, biology-inclusive map of severe mental illness.} Posterior indicator$\times $factor loadings for the eight-axis model fit to $N=9{,}013$ patients' observed cells (no imputation), with the map \emph {frozen before any validation stage}---a pre-specification that guards the downstream claims against overfitting. Routinely-collected biology (immunometabolic panel) enters as a co-equal latent axis alongside cognition, sleep and the symptom dimensions rather than as a downstream correlate. Marker size is $|$loading$|$; the general factor \Gfac {} is orthogonal to the specifics by construction (the primary-map coordinate choice). This map is the coordinate system; the degree to which each axis is entangled with general burden is not read from it (that is set to zero here by construction) but estimated from a free-correlation re-fit, where the immunometabolic axis proves the least entangled of all (Fig.~\ref {fig:hinge}). Unlike prior single-diagnosis immunometabolic-depression subtyping, biology here is a co-equal axis (not a correlate), measured without imputation, across bipolar disorder, schizophrenia and major depression}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {A graded continuum, not discrete biotypes.} (a)~Best silhouette versus a single-Gaussian null across $K$; the real data never clear the separation floor and a mixture selects $K=1$ in every draw. (b)~The two-dimensional cloud with diagnoses fully intermixed. (c)~General burden as a smooth gradient. (d)~Immunometabolic load varies along a different direction---a separate axis of the same continuum, not a pole of the severity gradient.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:continuum}{{2}{5}{\textbf {A graded continuum, not discrete biotypes.} (a)~Best silhouette versus a single-Gaussian null across $K$; the real data never clear the separation floor and a mixture selects $K=1$ in every draw. (b)~The two-dimensional cloud with diagnoses fully intermixed. (c)~General burden as a smooth gradient. (d)~Immunometabolic load varies along a different direction---a separate axis of the same continuum, not a pole of the severity gradient}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.4}The separable axis is the durable one}{5}{subsection.2.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Immunometabolic load is the least burden-entangled domain.} Free (correlated-\textit  {G}) correlation of each specific axis with general burden $\phi _{Gd}$ (bars), with the bifactor direct loadings $|\lambda _G|$ shown for comparison (diamonds). Immunometabolic load sits in the ``biology zone'' at $\approx 0.10$ ($0.06$ under confound adjustment), against $0.39$/$0.42$ for cognition/sleep. This is the primary estimand for the biology--severity question.}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:hinge}{{3}{6}{\textbf {Immunometabolic load is the least burden-entangled domain.} Free (correlated-\Gfac ) correlation of each specific axis with general burden $\phi _{Gd}$ (bars), with the bifactor direct loadings $|\lambda _G|$ shown for comparison (diamonds). Immunometabolic load sits in the ``biology zone'' at $\approx 0.10$ ($0.06$ under confound adjustment), against $0.39$/$0.42$ for cognition/sleep. This is the primary estimand for the biology--severity question}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Biology is trait; symptoms are state.} (a)~Trait fraction (test--retest ICC, baseline$\to $2 years) for each axis; immunometabolic load is the most durable ($0.91$). (b)~Individual rank stability against population change: symptom axes slide as the cohort improves, while immunometabolic load holds its rank (upper right).}}{6}{figure.4}\protected@file@percent }
\newlabel{fig:persistence}{{4}{6}{\textbf {Biology is trait; symptoms are state.} (a)~Trait fraction (test--retest ICC, baseline$\to $2 years) for each axis; immunometabolic load is the most durable ($0.91$). (b)~Individual rank stability against population change: symptom axes slide as the cohort improves, while immunometabolic load holds its rank (upper right)}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {The immunometabolic pole is the worst-prognosis corner.} (a)~All $9{,}013$ patients projected onto the five-archetype simplex as convex blends; position is the archetype-weight mix. (b)~The same map shaded by two-year functional remission (bin mean, bins $\ge 5$ patients, $n=2{,}420$ with follow-up): remission falls from $63\%$ at the well pole to $22\%$ at the immunometabolic pole. The immunometabolic corner is worse than the equally severe clean-biology corner---an axis a diagnosis or a severity score does not resolve.}}{7}{figure.5}\protected@file@percent }
\newlabel{fig:money}{{5}{7}{\textbf {The immunometabolic pole is the worst-prognosis corner.} (a)~All $9{,}013$ patients projected onto the five-archetype simplex as convex blends; position is the archetype-weight mix. (b)~The same map shaded by two-year functional remission (bin mean, bins $\ge 5$ patients, $n=2{,}420$ with follow-up): remission falls from $63\%$ at the well pole to $22\%$ at the immunometabolic pole. The immunometabolic corner is worse than the equally severe clean-biology corner---an axis a diagnosis or a severity score does not resolve}{figure.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.5}It marks the worst-prognosis pole---at the group level}{7}{subsection.2.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {The remission gradient is a property of the map.} (a)~The two-year functional-remission gradient across archetypes holds within each diagnosis (bipolar, schizophrenia, depression scored separately). (b)~Archetypes summarize the map $\approx 9.7\times $ more tightly than the DSM-5 label ($\eta ^{2}$ across the eight axes). (c)~Incremental held-out predictive density for functioning: the archetype encoding adds most, above the continuous map, tessellation and durable-biology-only encodings.}}{8}{figure.6}\protected@file@percent }
\newlabel{fig:prognosis_quant}{{6}{8}{\textbf {The remission gradient is a property of the map.} (a)~The two-year functional-remission gradient across archetypes holds within each diagnosis (bipolar, schizophrenia, depression scored separately). (b)~Archetypes summarize the map $\approx 9.7\times $ more tightly than the DSM-5 label ($\eta ^{2}$ across the eight axes). (c)~Incremental held-out predictive density for functioning: the archetype encoding adds most, above the continuous map, tessellation and durable-biology-only encodings}{figure.6}{}}
