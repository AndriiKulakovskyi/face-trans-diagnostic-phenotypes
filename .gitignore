# Project output (pipeline runs, figures) — regenerated, not tracked
output/

# Vendored sister-project raw cohort CSVs (confidential, ~52MB; BP/SZ/DR
# duplicate data/*.csv, plus ASP). Kept on disk as a working copy but NOT
# tracked: the engine is reused as a library, and cluster reproduction reads
# the precomputed data/external/face_stratification/*.parquet instead.

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Editors / IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# Local tool settings (do not commit machine-specific paths or keys)
.claude/settings.local.json

# Jupyter
.ipynb_checkpoints/

# Office temp/lock files
~$*

# Transient analysis scratch
results/_scratch/
results/reports/_scratch/

# Confidential patient data — never commit
data/*.csv
# …except non-confidential aggregate reference tables (no patient data)
!data/site_lookup.csv

# Per-patient derived artifacts — regenerated by run_all from raw data; not shared
results/*_scores.parquet
results/cluster_domains_embedding.parquet
results/cluster_domains_assignments.csv
results/longitudinal_assignments.csv
results/v0_clusters_anchor.csv
# v2 hierarchical-FA artifacts — regenerated by scripts 30-40_v2; contains per-patient
# matrices/scores (*.pkl) derived from confidential data — never commit the whole dir.
results/hfa/
.gstack/

# Rendered manuscript/figures — regenerable from manuscript.md + scripts (build_manuscript_v2,
# figures_manuscript_v2). Track only the manuscript source; keep the heavy binaries out of git.
results/manuscript/*
!results/manuscript/manuscript.md
results/reports/

# V3 outputs (scripts/v3/*). Aggregate reports are regenerable; factor_scores.csv + idata_core.nc
# contain per-patient posteriors derived from confidential data — never commit the dir.
results/v3/

# Model-ready per-patient tables (confidential; regenerated by scripts/01_build_data.py)
data/processed/
data/interim/
data/artifacts/

# Stage fit outputs (per-patient scores + idata; regenerable)
results/face/

# Confidential data archive — never commit
data.zip

# FACE-ATLAS technical report — commit the LaTeX sources, not the regenerable build artifacts (`make`)
report/*.pdf
report/*.aux
report/*.log
report/*.out
report/*.toc
