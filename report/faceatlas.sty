% (4) Hybrid discovery -> adjudication: candidate -> eligibility map (not-testable
%     if no indicators) -> one global fit -> empirical verdicts, with the real FACE outcomes.
\newcommand{\discoveryflow}{%
\begin{center}\resizebox{0.98\linewidth}{!}{%
\begin{tikzpicture}[>={Stealth[length=2.4mm]},font=\sffamily\footnotesize,
  box/.style={draw=faceaccent,line width=0.8pt,rounded corners=2.5pt,fill=white,align=center,minimum height=13mm,text width=24mm},
  chip/.style={rounded corners=2pt,font=\sffamily\scriptsize\bfseries,text=white,inner xsep=4pt,inner ysep=2.5pt,minimum width=20mm,align=center}]
  \node[box] (a) {candidate construct\\{\scriptsize clinical hypothesis}};
  \node[box,right=8mm of a] (e) {eligibility map\\{\scriptsize valid indicators?}};
  \node[box,right=8mm of e] (b) {one global\\Bayesian fit};
  \node[box,right=8mm of b] (c) {empirical\\dimension?};
  \draw[->,faceaccent,line width=0.9pt] (a)--(e);
  \draw[->,faceaccent,line width=0.9pt] (e)--(b);
  \draw[->,faceaccent,line width=0.9pt] (b)--(c);
  \node[chip,fill=facemute,below=11mm of e] (v5) {not-testable};
  \draw[->,facemute!80,line width=0.6pt] (e.south) -- (v5.north);
  \node[chip,fill=facekr,right=14mm of c,yshift=15mm] (v1) {confirmed};
  \node[chip,fill=facedef,right=14mm of c,yshift=5mm] (v2) {split};
  \node[chip,fill=faceinv,right=14mm of c,yshift=-5mm] (v3) {proxy};
  \node[chip,fill=facecav,right=14mm of c,yshift=-15mm] (v4) {rejected};
  \foreach \v in {v1,v2,v3,v4} {\draw[->,facemute!80,line width=0.6pt] (c.east) -- (\v.west);}
  \node[anchor=west,font=\sffamily\scriptsize,text=facemute] at (v1.east) {\ mania, substance};
  \node[anchor=west,font=\sffamily\scriptsize,text=facemute] at (v2.east) {\ biology $\to$ metabolic\,+\,inflammatory};
  \node[anchor=west,font=\sffamily\scriptsize,text=facemute] at (v3.east) {\ neurodevelopment};
  \node[anchor=west,font=\sffamily\scriptsize,text=facemute] at (v4.east) {\ anhedonia};
  \node[anchor=west,font=\sffamily\scriptsize,text=facemute] at (v5.east) {\ sensory, impulsivity, neg.\ symptoms};
\end{tikzpicture}}\end{center}}

